        "import numpy as np\n",
        "\n",
        "# ==========================================\n",
        "# 1. PROBLEM SETUP & DATA DEFINITIONS\n",
        "# ==========================================\n",
        "# Virtual Machine Specifications: [MIPS (CPU Speed), Memory Capacity (GB), Cost per second ($)]\n",
        "VM_SPECS = np.array([\n",
        "    [1000, 16, 0.05],  # VM 0: Standard\n",
        "    [2500, 32, 0.12],  # VM 1: Compute-Optimized\n",
        "    [1500, 64, 0.15],  # VM 2: Memory-Optimized\n",
        "    [800,  8,  0.02]   # VM 3: Light / Economy\n",
        "])\n",
        "\n",
        "# Task Specifications: [Workload (Million Instructions), Memory Required (GB)]\n",
        "np.random.seed(42)  # For reproducible results\n",
        "NUM_TASKS = 20\n",
        "TASK_WORKLOADS = np.random.randint(500, 5000, size=NUM_TASKS)\n",
        "TASK_MEMORY = np.random.randint(1, 16, size=NUM_TASKS)\n",
        "\n",
        "NUM_VMS = len(VM_SPECS)\n",
        "\n",
        "# ==========================================\n",
        "# 2. FITNESS / OBJECTIVE FUNCTION\n",
        "# ==========================================\n",
        "def evaluate_fitness(position):\n",
        "    \"\"\"\n",
        "    Decodes the continuous wolf position into concrete VM assignments\n",
        "    and computes the fitness score (lower score is better).\n",
        "    \"\"\"\n",
        "    # Round continuous values to get discrete VM indices\n",
        "    allocation = np.clip(np.round(position), 0, NUM_VMS - 1).astype(int)\n",
        "\n",
        "    vm_execution_times = np.zeros(NUM_VMS)\n",
        "    vm_memory_usage = np.zeros(NUM_VMS)\n",
        "    total_cost = 0.0\n",
        "\n",
        "    # Calculate load distribution and resource usage per VM\n",
        "    for task_idx, vm_idx in enumerate(allocation):\n",
        "        # Time = Workload (MI) / VM Speed (MIPS)\n",
        "        exec_time = TASK_WORKLOADS[task_idx] / VM_SPECS[vm_idx, 0]\n",
        "        vm_execution_times[vm_idx] += exec_time\n",
        "        vm_memory_usage[vm_idx] += TASK_MEMORY[task_idx]\n",
        "\n",
        "    # Calculate scheduling objectives\n",
        "    makespan = np.max(vm_execution_times)  # Total time taken by the slowest VM\n",
        "\n",
        "    for vm_idx in range(NUM_VMS):\n",
        "        total_cost += vm_execution_times[vm_idx] * VM_SPECS[vm_idx, 2]\n",
        "\n",
        "    # Constraint Handling: Heavy penalty if tasks exceed a VM's RAM capacity\n",
        "    penalty = 0.0\n",
        "    for vm_idx in range(NUM_VMS):\n",
        "        if vm_memory_usage[vm_idx] > VM_SPECS[vm_idx, 1]:\n",
        "            penalty += (vm_memory_usage[vm_idx] - VM_SPECS[vm_idx, 1]) * 100000\n",
        "\n",
        "    # Combine objectives (Weights: 60% completion speed, 40% operational expense)\n",
        "    w1, w2 = 0.6, 0.4\n",
        "    fitness = (w1 * makespan) + (w2 * total_cost) + penalty\n",
        "    return fitness\n",
        "\n",
        "# ==========================================\n",
        "# 3. GREY WOLF OPTIMIZER IMPLEMENTATION\n",
        "# ==========================================\n",
        "def grey_wolf_optimizer(num_wolves=30, max_iter=100):\n",
        "    # Initialize wolves continuously between 0 and the maximum VM index\n",
        "    wolves_pos = np.random.uniform(0, NUM_VMS - 1, size=(num_wolves, NUM_TASKS))\n",
        "\n",
        "    # Identify alpha, beta, and delta positions\n",
        "    alpha_pos = np.zeros(NUM_TASKS)\n",
        "    beta_pos = np.zeros(NUM_TASKS)\n",
        "    delta_pos = np.zeros(NUM_TASKS)\n",
        "\n",
        "    alpha_score = float(\"inf\")\n",
        "    beta_score = float(\"inf\")\n",
        "    delta_score = float(\"inf\")\n",
        "\n",
        "    # Main Optimization Loop\n",
        "    for t in range(max_iter):\n",
        "\n",
        "        # Step A: Evaluate fitness and update Alpha, Beta, Delta vectors\n",
        "        for i in range(num_wolves):\n",
        "            fitness = evaluate_fitness(wolves_pos[i])\n",
        "\n",
        "            if fitness < alpha_score:\n",
        "                delta_score = beta_score\n",
        "                delta_pos = beta_pos.copy()\n",
        "                beta_score = alpha_score\n",
        "                beta_pos = alpha_pos.copy()\n",
        "                alpha_score = fitness\n",
        "                alpha_pos = wolves_pos[i].copy()\n",
        "\n",
        "            elif fitness < beta_score:\n",
        "                delta_score = beta_score\n",
        "                delta_pos = beta_pos.copy()\n",
        "                beta_score = fitness\n",
        "                beta_pos = wolves_pos[i].copy()\n",
        "\n",
        "            elif fitness < delta_score:\n",
        "                delta_score = fitness\n",
        "                delta_pos = wolves_pos[i].copy()\n",
        "\n",
        "        # Step B: Linearly decay parameter 'a' from 2 down to 0\n",
        "        a = 2 - 2 * (t / max_iter)\n",
        "\n",
        "        # Step C: Update positions of all wolves based on leader dynamics\n",
        "        for i in range(num_wolves):\n",
        "            new_position = np.zeros(NUM_TASKS)\n",
        "\n",
        "            for j in range(NUM_TASKS):\n",
        "                # Update equations regarding Alpha (α)\n",
        "                r1, r2 = np.random.random(), np.random.random()\n",
        "                A1 = 2 * a * r1 - a\n",
        "                C1 = 2 * r2\n",
        "                D_alpha = abs(C1 * alpha_pos[j] - wolves_pos[i, j])\n",
        "                X1 = alpha_pos[j] - A1 * D_alpha\n",
        "\n",
        "                # Update equations regarding Beta (β)\n",
        "                r1, r2 = np.random.random(), np.random.random()\n",
        "                A2 = 2 * a * r1 - a\n",
        "                C2 = 2 * r2\n",
        "                D_beta = abs(C2 * beta_pos[j] - wolves_pos[i, j])\n",
        "                X2 = beta_pos[j] - A2 * D_beta\n",
        "\n",
        "                # Update equations regarding Delta (δ)\n",
        "                r1, r2 = np.random.random(), np.random.random()\n",
        "                A3 = 2 * a * r1 - a\n",
        "                C3 = 2 * r2\n",
        "                D_delta = abs(C3 * delta_pos[j] - wolves_pos[i, j])\n",
        "                X3 = delta_pos[j] - A3 * D_delta\n",
        "\n",
        "                # Calculate average position update\n",
        "                new_position[j] = (X1 + X2 + X3) / 3\n",
        "\n",
        "            # Boundary Check: Keep position values within valid VM array sizes\n",
        "            wolves_pos[i] = np.clip(new_position, 0, NUM_VMS - 1)\n",
        "\n",
        "    return np.clip(np.round(alpha_pos), 0, NUM_VMS - 1).astype(int)\n",
        "\n",
        "# ==========================================\n",
        "# 4. EXECUTION & RESULTS PRESENTATION\n",
        "# ==========================================\n",
        "if __name__ == \"__main__\":\n",
        "    print(\"Running Grey Wolf Optimizer for Cloud Resource Allocation...\")\n",
        "    best_schedule = grey_wolf_optimizer(num_wolves=35, max_iter=150)\n",
        "\n",
        "    # Calculate metrics for the final alpha configuration\n",
        "    vm_times = np.zeros(NUM_VMS)\n",
        "    vm_mems = np.zeros(NUM_VMS)\n",
        "    final_cost = 0.0\n",
        "\n",
        "    for t_idx, v_idx in enumerate(best_schedule):\n",
        "        exec_t = TASK_WORKLOADS[t_idx] / VM_SPECS[v_idx, 0]\n",
        "        vm_times[v_idx] += exec_t\n",
        "        vm_mems[v_idx] += TASK_MEMORY[t_idx]\n",
        "        final_cost += exec_t * VM_SPECS[v_idx, 2]\n",
        "\n",
        "    print(\"\\n\" + \"=\"*60)\n",
        "    print(\"OPTIMAL RESOURCE ALLOCATION SCHEDULING (GWO)\")\n",
        "    print(\"=\"*60)\n",
        "    print(f\"Optimal Task-to-VM Mapping Array:\\n{best_schedule}\")\n",
        "    print(f\"System Makespan (Max Execution Time): {np.max(vm_times):.2f} seconds\")\n",
        "    print(f\"Total Operational Expense: ${final_cost:.2f}\")\n",
        "\n",
        "    print(\"\\nVirtual Machine Workload Metrics:\")\n",
        "    for i in range(NUM_VMS):\n",
        "        print(f\" -> VM {i}: Execution Time = {vm_times[i]:.2f}s | \"\n",
        "              f\"Memory Load = {vm_mems[i]}/{VM_SPECS[i,1]} GB\")\n",
        "    print(\"=\"*60)\n"
      ]
    }
